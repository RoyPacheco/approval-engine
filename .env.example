# ─── Frontend (Vite / browser-safe) ─────────────────────────────────────────
VITE_APP_NAME="Approval Chain Creator"
VITE_APP_VERSION="2.0.0"

# API base URL — leave empty in dev (Vite proxy handles /api/*).
# Set to your deployed backend URL in production, e.g.:
# VITE_API_URL=https://api.your-app.example.com
VITE_API_URL=

# ─── Backend (Python FastAPI — see backend/.env.example) ─────────────────────
# Coupa OAuth credentials live ONLY in the backend .env, never here.
# The frontend never sees CLIENT_ID or CLIENT_SECRET.
#
# Copy backend/.env.example → backend/.env and fill in your Coupa credentials.
# Start the backend:  cd backend && uvicorn app.main:app --reload
