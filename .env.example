# ─── App ─────────────────────────────────────────────────────────────────────
# These are safe to expose to the browser (VITE_ prefix).
VITE_APP_NAME="Approval Chain Creator"
VITE_APP_VERSION="2.0.0"

# ─── Coupa API (client-side safe — non-secret only) ──────────────────────────
# Base URL for your Coupa instance. Exposed to the browser.
VITE_COUPA_API_URL="https://yourinstance.coupahost.com"

# OAuth2 scope(s) required by your Coupa application.
VITE_COUPA_SCOPE="core:requisitions:read core:approvals:read"

# ─── Coupa OAuth secrets (SERVER-SIDE ONLY — NO VITE_ prefix) ────────────────
# NEVER expose these to the browser. Use a backend proxy / serverless function
# to exchange the client credentials and forward API calls.
#
# COUPA_CLIENT_ID="your-oauth-client-id"
# COUPA_CLIENT_SECRET="your-oauth-client-secret"
#
# Example proxy endpoint your backend should expose:
# POST /api/coupa/token   → exchanges credentials for a bearer token
# GET  /api/coupa/*       → proxies authenticated requests to Coupa
