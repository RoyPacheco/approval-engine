# ── Coupa OAuth credentials (server-side only — never exposed to the browser) ──
COUPA_CLIENT_ID=your_client_id_here
COUPA_CLIENT_SECRET=your_client_secret_here
COUPA_API_URL=https://your-instance.coupahost.com
COUPA_SCOPE=core.approval.chains.read core.approval.chains.write

# ── Storage ───────────────────────────────────────────────────────────────────
# Path where JSON files (chains.json, workflows.json, etc.) are written.
# Change to an absolute path or swap the storage module for a DB adapter.
DATA_DIR=./data

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (handled in config.py).
# Default covers the Vite dev server; add your production domain here.
# CORS_ORIGINS=["http://localhost:5173","https://your-app.example.com"]
